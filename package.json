{
  "name": "dsh-web-aichat",
  "version": "0.1.6",
  "description": "DSH 左侧栏 AI 官网聊天聚合面板：顶部切换多个 AI，保留已打开页面。",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "scripts/desktop-persistence.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DescartHsu/dsh-web-AIchat.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai-chat"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "check": "pnpm test",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
